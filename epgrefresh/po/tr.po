msgstr "EPG'yi otomatik kaydet"

msgid "Background only"
msgstr "Yalnızca arka planda"

msgid ""
"Backup file is corrupt!\n"
"Backup file will be deleted!"
msgstr ""
"Yedek dosyası bozuk!\n"
"Yedek dosyası silinecek!"

msgid "Backup file is not found!"
msgstr "Yedek dosyası bulunamadı!"

msgid "Backup file load!"
msgstr "Yedek dosyası yüklendi!"

