msgstr ""

msgid "Save search as AutoTimer"
msgstr "Uložit hledání jako AutoTimer"

msgid "Search"
msgstr "Hledat"

msgid "Search EPG by title event"
msgstr "Vyhledávání události v EPG podle názvu"

msgid "Search event in EPG"
msgstr "Najít událost v EPG"

msgid "Search only bouquets"
msgstr "Hledat pouze v přehledech"

msgid "Search strictness"
msgstr "Přesnost vyhledávání"

msgid "Search type"
msgstr "Typ hledání"

msgid "Result filter"
msgstr "Filtr výsledku vyhledání"

msgid "Select a timer to search"
msgstr "Výběr časovače pro hledání"

msgid "Select action:"
msgstr "Zvolte akci:"

msgid "Select channel"
msgstr "Vyberte kanál"

msgid "Select item for search and press 'OK' or edit item with yellow button or delete item with blue button."
msgstr "Zvolte položku pro hledání a stiskněte 'OK' nebo použijte žluté tlačítko pro úpravu nebo modré tlačítko pro odstranění."

msgid "Use P+/- to filter result by short description or extended (only if short is missing). Partial: only items whose description is contained in selected event. Exact: only items with matching description. Full: identical whole description."
msgstr "Použijte CH+/- pro filtrování výsledku podle krátkého nebo rozšířeného popisu (jen pokud krátký chybí). Částečně odpovídá – položky, jejichž popis je obsažen v označené události. Přesně odpovídá – položky se shodným popisem. Úplná shoda – celý popis se shoduje."

msgid "Select type for search, \"partial match\" for the most extensive search, \"partial description\" for the most description search."
msgstr "Zvolte typ hledání. \"Částečně odpovídá\" pro rozsáhlá vyhledávání, \"Částečně v popisu\" pro vyhledávání v popisech."

msgid "Select type: 'Search and Select channel' or 'Search'."
msgstr "Zvolte 'Hledat' nebo 'Výběr akce (Hledat, Vyberte kanál, Uživatelské hledání)'."

msgid "Select whether or not you want to enforce case correctness."
msgstr "Zvolte, zda při hledání chcete rozlišovat velikost písmen."

msgid "Setup"
msgstr "Nastavení..."

msgid "Timers list"
msgstr "Přehled časovačů"

msgid "Type blue Button"
msgstr "Možnosti modrého tlačítka"

msgid "Use Picons"
msgstr "Používat pikony"

msgid "Use the current event name as the initial search text. An empty search field is used otherwise."
msgstr "Použít aktuální název ve vyhledávacím poli, jinak ponechat vyhledávací pole prázdné."

msgid "Use event name for yellow button search"
msgstr "Použít název pro hledání žlutým tlačítkem"

msgid "Zap to selected service"
msgstr "Přepnout na vybraný program"

msgid "case-insensitive search"
msgstr "Nerozlišovat velikost písmen"

msgid "case-sensitive search"
msgstr "Rozlišovat velikost písmen"

msgid "choice (Search and standard)"
msgstr "Výběr akce (Hledat, Vyberte kanál,...)"

msgid "exact match"
msgstr "Přesně odpovídá"

msgid "only Search"
msgstr "Pouze 'Hledat'"

msgid "partial description"
msgstr "Částečně odpovídá v popisu"

msgid "partial match"
msgstr "Částečně odpovídá"

msgid "search EPG"
msgstr "Prohledat EPG"

msgid "search EPG..."
msgstr "Hledat v EPG..."

msgid "title ends with"
msgstr "Název končí na"

msgid "title starts with"
msgstr "Název začíná na"
