msgstr "İptal"

msgid "Channel Selection"
msgstr "Kanal seçimi"

msgid "Choice list"
msgstr "Seçenek listesi"

msgid "Choice list EPGSearch"
msgstr "EPGSearch seçenek listesi"

msgid "Choice list RED Button"
msgstr "Kırmızı tuş seçenek listesi"

msgid "Clear history"
msgstr "Geçmişi temizle"

