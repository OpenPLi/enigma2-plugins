msgid "Add new tag..."
msgstr "Yeni etiket ekle..."

msgid "Cancel"
msgstr "İptal"

msgid "Delete all tags..."
msgstr "Tüm etiketleri sil..."

msgid "Delete this tag..."
msgstr "Bu etiketi sil..."

msgid "Delete unused tags"
msgstr "Kullanılmayan etiketleri sil"

msgid ""
"Do you really want to delete all tags everywhere?\n"
"(Note that 'Cancel' will not undo this!)"
msgstr ""
"Tüm etiketler her yerden silinsin mi?\n"
"('İptal' seçeneği bu işlemi geri almaz!)"

#, python-format
msgid ""
"Do you really want to delete tag \"%s\" everywhere?\n"
"(Note that 'Cancel' will not undo this!)"
msgstr ""
"\"%s\" etiketi her yerden silinsin mi?\n"
"('İptal' seçeneği bu işlemi geri almaz!)"

#. TRANSLATORS: This is the title of the TagEditor main screen
msgid "Edit Tags"
msgstr "Etiketleri düzenle"

msgid "Load"
msgstr "Yükle"

msgid "New"
msgstr "Yeni"

msgid "OK"
msgstr "Tamam"

msgid "Please enter the new tag"
msgstr "Yeni etiketi girin"

msgid "Rename this tag..."
msgstr "Bu etiketi yeniden adlandır..."

#, python-format
msgid ""
"Replace tag \"%s\" everywhere with:   (Note that 'Cancel' will not undo "
"this!)"
msgstr ""
"\"%s\" etiketinin her yerde değiştirileceği metin:   ('İptal' seçeneği bu "
"işlemi geri almaz!)"

#. TRANSLATORS: this is the string used in the movie context menu for
